# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is gitignored. NEVER commit it, and never paste a real token into this
# example file — it IS tracked by git.

# ---------------------------------------------------------------------------
# TMDB (Phase 2)
# ---------------------------------------------------------------------------
# Application-level "API Read Access Token" from
# https://www.themoviedb.org/settings/api
# This is the long v4 bearer token, NOT the short v3 API key.
# It is sent as: Authorization: Bearer <token>
# Leave blank in Phase 1 — the mocked catalogue service does not need it.
TMDB_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Catalogue service selection
# ---------------------------------------------------------------------------
# mock = seeded fixtures, no network (Phase 1)
# live = real TMDB via the MCP server (Phase 2)
CATALOGUE_SERVICE=mock

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Do not use "*".
# Omit this in local development to fall back to the localhost defaults in
# app/main.py.
# CORS_ORIGINS=https://movienightplanner.example,https://www.movienightplanner.example
